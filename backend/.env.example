# Environment Configuration for ClinixLens Backend
# Copy this file to .env and fill in your values

# ============================================
# AI / LLM Configuration
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ============================================
# Google Cloud Vision OCR
# ============================================
# Option 1: Use API key (simpler)
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here
# Option 2: Use service account JSON path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ============================================
# Database
# ============================================
# For local development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./clinixlens.db

# For production (PostgreSQL on Render)
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# ============================================
# Application
# ============================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# File Upload
# ============================================
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads

# ============================================
# Security
# ============================================
SECRET_KEY=change-this-to-a-random-secret-key
